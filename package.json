{
  "name": "automacao-gta-6",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Leitor local de pacotes GTA 6 PIRA Feed V5 (MVP somente console)",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types src/cli.ts",
    "inspect": "node --experimental-strip-types src/cli.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.19.7",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "playwright-core": "1.56.1"
  }
}
